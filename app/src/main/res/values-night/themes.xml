<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark system theme: the window starts dark, so a dark-mode cold start never flashes white. -->
    <style name="Theme.ToolBox" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/toolbox_window_background</item>
        <item name="android:dialogTheme">@style/Theme.ToolBox.Dialog</item>
    </style>
    <!-- Compose Dialog resolves android:dialogTheme before its Window is created. -->
    <style name="Theme.ToolBox.Dialog" parent="android:style/Theme.Material.Dialog.MinWidth">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
