<?xml version="1.0" encoding="utf-8"?>
<!-- Modal dialog window: grows from 94% with a fade, decelerating like a damped spring. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/toolbox_emphasized_decelerate"
    android:shareInterpolator="true">
    <scale
        android:duration="320"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
    <alpha
        android:duration="200"
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
