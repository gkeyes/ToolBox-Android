<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet window exit: 220ms accelerate, moves down while the sheet and scrim fade. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:interpolator="@interpolator/toolbox_exit"
    android:shareInterpolator="true">
    <translate
        android:fromYDelta="0"
        android:toYDelta="12%" />
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
