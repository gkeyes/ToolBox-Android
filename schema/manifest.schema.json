{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolbox.invalid/schema/manifest-v1.json",
  "title": "ToolBox Mini App Manifest v1",
  "description": "Manifest for a ToolBox .tbx mini-app package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "versionCode",
    "entry",
    "apiVersion",
    "minHostVersion",
    "permissions",
    "securityProfile"
  ],
  "allOf": [
    {
      "description": "background.runtime, location.background and alarms require minHostVersion 0.3.0 or newer.",
      "if": {
        "required": [
          "permissions"
        ],
        "properties": {
          "permissions": {
            "contains": {
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "background.runtime",
                    "location.background",
                    "alarms"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "minHostVersion": {
            "pattern": "^(?:0*[1-9][0-9]*\\.[0-9]+|0+\\.0*(?:[3-9]|[1-9][0-9]+))\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*){2,}$",
      "description": "Reverse-domain identifier, for example io.toolbox.positioncalculator."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "entry": {
      "$ref": "#/$defs/relativeHtmlPath"
    },
    "icon": {
      "$ref": "#/$defs/relativeAssetPath"
    },
    "apiVersion": {
      "const": "1.0",
      "description": "Current ToolBox JS API contract."
    },
    "minHostVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 19,
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "storage"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "storage.secure"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "clipboard.write"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "clipboard.read"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "share"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "browser"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "files.open"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "files.save"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "network"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "device.basic"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "haptics"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "notifications"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "shortcuts"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "camera"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "location"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "background.tasks"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "background.runtime"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "location.background"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "alarms"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "enum": [
              "storage",
              "storage.secure",
              "clipboard.write",
              "clipboard.read",
              "share",
              "browser",
              "files.open",
              "files.save",
              "network",
              "device.basic",
              "haptics",
              "notifications",
              "shortcuts",
              "camera",
              "location",
              "background.tasks",
              "background.runtime",
              "location.background",
              "alarms"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "network": {
      "description": "Optional request budgets. Network access requires the network capability grant.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Optional cumulative response budget as a positive JavaScript safe integer. Omitted means no additional cumulative limit. Whole-body APIs remain subject to current shared memory and array/string representation capacity."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0,
          "description": "Optional caller-selected deadline in milliseconds; 0 disables the deadline. The numeric maximum is the HTTP client millisecond representation."
        }
      }
    },
    "securityProfile": {
      "enum": [
        "strict",
        "compat"
      ],
      "description": "Both profiles allow standard WebView WebAssembly (wasm-unsafe-eval), same-origin resource reads and same-origin Dedicated Workers without extra permissions. strict forbids inline script; compat allows inline script. Both forbid JavaScript unsafe-eval and direct remote subresources."
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "enum": [
            "unspecified",
            "portrait",
            "landscape"
          ],
          "description": "Screen orientation while the tool is on screen. portrait locks portrait, landscape allows either landscape side, unspecified (or omitted) follows the device."
        },
        "allowFullscreen": {
          "type": "boolean",
          "default": false,
          "description": "Whether element fullscreen (requestFullscreen, a video's fullscreen button) may cover the tool and hide the system bars. When false the request is refused and the page leaves fullscreen at once."
        },
        "statusBarStyle": {
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "Status bar icon colour while the tool is on screen: light draws light icons for a dark page, dark draws dark icons for a light page, auto follows the ToolBox theme."
        },
        "showHostToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Ignored. The host never draws a toolbar over a running tool; still accepted so existing packages keep installing."
        }
      }
    }
  },
  "$defs": {
    "relativeHtmlPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(?!\\.\\.?(?:/|$))[A-Za-z0-9._-]{1,255}/)*(?!\\.\\.?(?:/|$))[A-Za-z0-9._-]{0,250}\\.html$"
    },
    "relativeAssetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(?!\\.\\.?(?:/|$))[A-Za-z0-9._-]{1,255}/)*(?!\\.\\.?(?:/|$))[A-Za-z0-9._-]{1,255}$"
    }
  }
}
