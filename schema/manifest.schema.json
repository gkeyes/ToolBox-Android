{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolbox.invalid/schema/manifest-v1.json",
  "title": "ToolBox Mini App Manifest v1",
  "description": "Manifest for a ToolBox .tbx mini-app package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "versionCode",
    "entry",
    "apiVersion",
    "minHostVersion",
    "permissions",
    "securityProfile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*){2,}$",
      "description": "Reverse-domain identifier, for example io.toolbox.positioncalculator."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "description": {
      "type": "string",
      "maxLength": 240
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "entry": {
      "$ref": "#/$defs/relativeHtmlPath"
    },
    "icon": {
      "$ref": "#/$defs/relativeAssetPath"
    },
    "apiVersion": {
      "const": "1.0",
      "description": "ToolBox JS API compatibility level."
    },
    "minHostVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "categories": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 15,
      "allOf": [
        {"contains":{"properties":{"name":{"const":"storage"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"storage.secure"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"clipboard.write"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"clipboard.read"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"share"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"files.open"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"files.save"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"network"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"device.basic"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"haptics"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"notifications"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"shortcuts"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"camera"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"location"}},"required":["name"]},"minContains":0,"maxContains":1},
        {"contains":{"properties":{"name":{"const":"background.tasks"}},"required":["name"]},"minContains":0,"maxContains":1}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "enum": [
              "storage",
              "storage.secure",
              "clipboard.write",
              "clipboard.read",
              "share",
              "files.open",
              "files.save",
              "network",
              "device.basic",
              "haptics",
              "notifications",
              "shortcuts",
              "camera",
              "location",
              "background.tasks"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowDomains"
      ],
      "properties": {
        "allowDomains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^(?:\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
          }
        },
        "allowRedirects": {
          "type": "boolean",
          "default": false
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760,
          "default": 1048576
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000,
          "default": 15000
        }
      }
    },
    "securityProfile": {
      "enum": [
        "strict",
        "compat"
      ],
      "description": "strict forbids inline script/eval and direct remote subresources; compat may allow inline script after explicit warning, but never unsafe-eval."
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "enum": [
            "unspecified",
            "portrait",
            "landscape"
          ]
        },
        "allowFullscreen": {
          "type": "boolean",
          "default": false
        },
        "statusBarStyle": {
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto"
        },
        "showHostToolbar": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageBytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 52428800,
          "default": 2097152
        },
        "maxBridgePayloadBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576,
          "default": 262144
        }
      }
    }
  },
  "$defs": {
    "relativeHtmlPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+\\.html$"
    },
    "relativeAssetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "type": "object",
              "properties": {
                "name": {
                  "const": "network"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "network"
        ]
      }
    }
  ]
}
