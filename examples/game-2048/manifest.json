{
  "schemaVersion": 1,
  "id": "io.toolbox.game2048",
  "name": "2048",
  "shortName": "2048",
  "description": "离线滑动合并数字，支持计分、最高分、撤销和自动保存。",
  "version": "1.0.0",
  "versionCode": 1,
  "entry": "index.html",
  "icon": "icon.svg",
  "apiVersion": "1.0",
  "minHostVersion": "0.2.0",
  "categories": ["游戏", "益智"],
  "permissions": [
    {"name": "storage", "reason": "保存当前棋局和最高分。", "required": false},
    {"name": "haptics", "reason": "滑动和合并时提供轻触反馈。", "required": false}
  ],
  "securityProfile": "strict",
  "ui": {
    "orientation": "unspecified",
    "allowFullscreen": false,
    "statusBarStyle": "auto",
    "showHostToolbar": true
  },
  "limits": {
    "storageBytes": 65536,
    "maxBridgePayloadBytes": 4096
  }
}
