{
  "schemaVersion": 1,
  "id": "io.toolbox.kegeltrainer",
  "name": "稳力",
  "shortName": "稳力",
  "description": "离线男性盆底训练：节奏倒计时、提示音、语音和震动反馈。",
  "version": "1.0.5",
  "versionCode": 6,
  "entry": "index.html",
  "icon": "icon.png",
  "apiVersion": "1.0",
  "minHostVersion": "0.8.28",
  "categories": [
    "健康",
    "训练"
  ],
  "permissions": [
    {
      "name": "storage",
      "reason": "保存训练偏好和完成记录。",
