    },
    {
      "name": "haptics",
      "reason": "训练阶段切换时提供震动提示。",
      "required": false
    }
  ],
  "securityProfile": "strict",
  "ui": {
    "orientation": "unspecified",
    "allowFullscreen": false,
    "statusBarStyle": "auto",
    "showHostToolbar": true
  }
}
