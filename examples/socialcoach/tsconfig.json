{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "noEmit": true, "allowImportingTsExtensions": true,
    "baseUrl": ".", "paths": {"@/*": ["src/*"], "@platform/*": ["platform/*"]}
  },
  "include": ["src", "platform", "vite.config.ts"]
}
