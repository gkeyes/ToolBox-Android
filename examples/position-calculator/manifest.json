{
  "schemaVersion": 1,
  "id": "io.toolbox.positioncalculator",
  "name": "仓位计算器",
  "shortName": "仓位",
  "description": "根据账户资金、入场价和止损价计算风险仓位。",
  "version": "1.0.1",
  "versionCode": 2,
  "entry": "index.html",
  "icon": "icon.png",
  "apiVersion": "1.0",
  "minHostVersion": "0.2.0",
  "categories": [
    "计算",
    "投资"
  ],
  "permissions": [
    {
      "name": "storage",
      "reason": "保存上次计算参数。",
      "required": false
    },
    {
      "name": "clipboard.write",
      "reason": "复制计算结果。",
      "required": false
    },
    {
      "name": "haptics",
      "reason": "计算完成时提供触觉反馈。",
      "required": false
    }
  ],
  "securityProfile": "strict",
  "ui": {
    "orientation": "portrait",
    "allowFullscreen": false,
    "statusBarStyle": "auto",
    "showHostToolbar": true
  }
}
