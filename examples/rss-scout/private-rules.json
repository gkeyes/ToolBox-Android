{
  "schemaVersion": 1,
  "name": "gkeyes RSS Scout 私人发现规则",
  "updatedAt": "2026-09-28T00:00:00+09:00",
  "rules": [
    {
      "id": "telegram-channel-direct",
      "title": "Telegram 频道",
      "hosts": [
        "t.me",
        "telegram.me"
      ],
      "source": [
        "/:channel"
      ],
      "targets": {
        "rsshub": "/telegram/channel/:channel",
        "worker": "/rss/telegram/channel/:channel"
      },
      "paramDeny": {
        "channel": [
          "s",
          "c",
          "share",
          "proxy",
          "addstickers",
          "joinchat",
          "login",
          "iv"
        ]
      },
      "paramDenyPrefix": {
        "channel": [
          "+"
        ]
      }
    },
    {
      "id": "telegram-channel-preview",
      "title": "Telegram 频道",
      "hosts": [
        "t.me",
        "telegram.me"
      ],
      "source": [
        "/s/:channel"
      ],
      "targets": {
        "rsshub": "/telegram/channel/:channel",
        "worker": "/rss/telegram/channel/:channel"
      }
    },
    {
      "id": "telega-channel",
      "title": "Telegram 频道（Telega）",
      "hosts": [
        "telega.io",
        "www.telega.io"
      ],
      "source": [
        "/c/:channel",
        "/channels/:channel/card"
      ],
      "targets": {
        "rsshub": "/telegram/channel/:channel",
        "worker": "/rss/telegram/channel/:channel"
      }
    },
    {
      "id": "bilibili-user-dynamic",
      "title": "Bilibili 用户动态",
      "hosts": [
        "space.bilibili.com"
      ],
      "source": [
        "/:uid/dynamic"
      ],
      "targets": {
        "rsshub": "/bilibili/user/dynamic/:uid",
        "worker": "/rss/bilibili/user/dynamic/:uid"
      }
    },
    {
      "id": "bilibili-user-video",
      "title": "Bilibili 用户视频",
      "hosts": [
        "space.bilibili.com"
      ],
      "source": [
        "/:uid/video"
      ],
      "targets": {
        "rsshub": "/bilibili/user/video/:uid",
        "worker": "/rss/bilibili/user/video/:uid"
      }
    },
    {
      "id": "weibo-user",
      "title": "微博用户",
      "hosts": [
        "weibo.com",
        "www.weibo.com",
        "m.weibo.cn"
      ],
      "source": [
        "/u/:uid"
      ],
      "targets": {
        "rsshub": "/weibo/user/:uid",
        "worker": "/rss/weibo/user/:uid"
      }
    },
    {
      "id": "xiaohongshu-user",
      "title": "小红书用户",
      "hosts": [
        "xiaohongshu.com",
        "www.xiaohongshu.com"
      ],
      "source": [
        "/user/profile/:uid"
      ],
      "targets": {
        "rsshub": "/xiaohongshu/user/:uid/notes",
        "worker": "/rss/xiaohongshu/user/:uid"
      }
    },
    {
      "id": "github-actions-success",
      "title": "GitHub Actions 成功运行",
      "hosts": [
        "github.com",
        "www.github.com"
      ],
      "source": [
        "/:owner/:repo/actions/workflows/:workflow"
      ],
      "targets": {
        "worker": "/rss/github/actions/:owner/:repo/:workflow"
      }
    },
    {
      "id": "geekerline-newsflashes",
      "title": "Geeker 每日发现",
      "hosts": [
        "geekerline.com",
        "www.geekerline.com"
      ],
      "source": [
        "/newsflashes"
      ],
      "targets": {
        "rsshub": "/geekerline/newsflashes"
      }
    },
    {
      "id": "geekerline-select-share",
      "title": "Geeker 精选分享",
      "hosts": [
        "geekerline.com",
        "www.geekerline.com"
      ],
      "source": [
        "/select-share"
      ],
      "targets": {
        "rsshub": "/geekerline/select-share"
      }
    },
    {
      "id": "kejiwanjia-jingxuanpost",
      "title": "科技玩家精选",
      "hosts": [
        "kejiwanjia.com",
        "www.kejiwanjia.com"
      ],
      "source": [
        "/jingxuanpost"
      ],
      "targets": {
        "rsshub": "/kejiwanjia/jingxuanpost"
      }
    },
    {
      "id": "heiliao-latest",
      "title": "黑料网 最新",
      "hosts": [
        "heiliao.com",
        "www.heiliao.com"
      ],
      "source": [
        "/"
      ],
      "targets": {
        "rsshub": "/heiliao/latest"
      }
    }
  ]
}
