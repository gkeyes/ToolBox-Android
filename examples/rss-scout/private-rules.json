  "rules": [
    {
      "id": "telegram-rsshub-direct",
      "title": "Telegram 频道（RSSHub）",
      "service": "rsshub",
      "hosts": [
        "t.me",
        "telegram.me"
      ],
      "source": [
        "/:channel"
      ],
      "target": "/telegram/channel/:channel",
      "paramDeny": {
        "channel": [
          "s",
          "c",
          "share",
          "proxy",
          "addstickers",
          "joinchat",
          "login",
          "iv"
        ]
      },
      "paramDenyPrefix": {
        "channel": [
          "+"
        ]
      }
    },
    {
      "id": "telegram-rsshub-preview",
