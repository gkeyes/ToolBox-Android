{
  "schemaVersion": 2,
  "verifiedAt": "2026-09-28",
  "services": {
    "rsshub": {
      "description": "RSSHub 官方/自建实例；由 RSS Scout 的 RSSHub 地址决定"
    },
    "worker": {
      "implementationRepo": "gkeyes/RSSWorker",
      "mount": "/rss",
      "description": "私人 RSSWorker；由 RSS Scout 的 RSSWorker 地址决定"
    }
  },
  "routes": [
    {
      "id": "telegram-channel",
      "source": "https://t.me/:username",
      "targets": {
        "rsshub": "/telegram/channel/:username",
        "worker": "/rss/telegram/channel/:username"
      }
    },
    {
      "id": "bilibili-dynamic",
      "source": "https://space.bilibili.com/:uid/dynamic",
      "targets": {
        "rsshub": "/bilibili/user/dynamic/:uid",
        "worker": "/rss/bilibili/user/dynamic/:uid"
      }
    },
    {
      "id": "bilibili-video",
      "source": "https://space.bilibili.com/:uid/video",
      "targets": {
        "rsshub": "/bilibili/user/video/:uid",
        "worker": "/rss/bilibili/user/video/:uid"
      }
    },
    {
      "id": "weibo-user",
      "source": "https://m.weibo.cn/u/:uid",
      "targets": {
        "rsshub": "/weibo/user/:uid",
        "worker": "/rss/weibo/user/:uid"
      }
    },
    {
      "id": "xiaohongshu-user",
      "source": "https://www.xiaohongshu.com/user/profile/:uid",
      "targets": {
        "rsshub": "/xiaohongshu/user/:uid/notes",
        "worker": "/rss/xiaohongshu/user/:uid"
      }
    },
    {
      "id": "github-actions-success",
      "source": "https://github.com/:owner/:repo/actions/workflows/:workflow",
      "targets": {
        "worker": "/rss/github/actions/:owner/:repo/:workflow"
      }
    },
    {
      "id": "geekerline-newsflashes",
      "source": "https://geekerline.com/newsflashes",
      "targets": {
        "rsshub": "/geekerline/newsflashes"
      }
    },
    {
      "id": "geekerline-select-share",
      "source": "https://geekerline.com/select-share",
      "targets": {
        "rsshub": "/geekerline/select-share"
      }
    },
    {
      "id": "kejiwanjia-jingxuanpost",
      "source": "https://kejiwanjia.com/jingxuanpost",
      "targets": {
        "rsshub": "/kejiwanjia/jingxuanpost"
      }
    },
    {
      "id": "heiliao-latest",
      "source": "https://heiliao.com/",
      "targets": {
        "rsshub": "/heiliao/latest"
      }
    }
  ]
}
