{
  "schemaVersion": 1,
  "verifiedAt": "2026-09-27",
  "implementationRepo": "gkeyes/RSSWorker",
  "mount": "/rss",
  "verifiedRoutes": [
    {"id":"bilibili-dynamic","route":"/rss/bilibili/user/dynamic/:uid","source":"https://space.bilibili.com/:uid/dynamic"},
    {"id":"bilibili-video","route":"/rss/bilibili/user/video/:uid","source":"https://space.bilibili.com/:uid/video"},
    {"id":"telegram-channel","route":"/rss/telegram/channel/:username","source":"https://t.me/:username"},
    {"id":"weibo-user","route":"/rss/weibo/user/:uid","source":"https://m.weibo.cn/u/:uid"},
    {"id":"xiaohongshu-user","route":"/rss/xiaohongshu/user/:uid","source":"https://www.xiaohongshu.com/user/profile/:uid"}
  ],
  "discussedNotImplemented": [
    {"id":"github-actions-success","proposedRoute":"/github/actions/:owner/:repo/:workflow","status":"not found in current RSSWorker code"},
    {"id":"heiliao-latest","proposedRoute":"/heiliao/latest","status":"not found in current RSSWorker code"},
    {"id":"heiliao-category","proposedRoute":"/heiliao/category/:slug","status":"not found in current RSSWorker code"}
