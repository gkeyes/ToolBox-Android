{
  "schemaVersion": 1,
  "id": "io.gkeyes.seamlessstitch",
  "name": "无缝长图",
  "shortName": "长图拼接",
  "description": "按顺序添加多张滚动截图，拖动调整位置，本地拼成一张长图。支持接缝微调、PNG 无损和 JPG 多画质导出。",
  "version": "1.3.2",
  "versionCode": 8,
  "entry": "index.html",
  "icon": "icon.svg",
  "apiVersion": "1.0",
  "minHostVersion": "0.8.28",
  "categories": [
    "图片",
    "效率"
  ],
  "permissions": [
    {
      "name": "files.open",
      "reason": "选择并读取需要拼接的截图，仅在本机处理",
      "required": false
    },
    {
      "name": "files.save",
      "reason": "把拼接结果保存为 PNG 或 JPG 图片",
      "required": false
    }
  ],
  "securityProfile": "strict",
  "ui": {
    "orientation": "unspecified",
    "allowFullscreen": false,
    "statusBarStyle": "auto",
    "showHostToolbar": true
  }
}
